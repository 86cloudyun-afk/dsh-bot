 test('remove and rejoin atomically revokes old-generation delivery and outbox',()=>{const f=setup();const r=f.cmd('sendMessage',{groupId:f.g1.groupId,content:'old',recipients:['B']}).result;f.cmd('changeMembership',{groupId:f.g1.groupId,remove:[f.bots[1].botId],add:[f.bots[1].botId]},f.g1.revision);const d=r.deliveries[0];assert.equal(f.ledger.get('delivery',d.deliveryId).state,'revoked');assert.equal(f.ledger.get('outbox',d.deliveryId).state,'revoked');f.ledger.close();});
 test('first send or meeting with stale group revision is refused',()=>{const f=setup();f.cmd('changeMembership',{groupId:f.g1.groupId,remove:[f.bots[1].botId],add:[f.bots[1].botId]},f.g1.revision);assert.throws(()=>f.cmd('sendMessage',{groupId:f.g1.groupId,content:'stale',recipients:['B']},f.g1.revision),{code:'revision_conflict'});assert.throws(()=>f.cmd('startMeeting',{groupId:f.g1.groupId,topic:'stale',materials:[],maxOpinions:3},f.g1.revision),{code:'revision_conflict'});f.ledger.close();});
 test('revoked participant has explicit missing reason and cannot block or leak into reveal',()=>{const f=setup();let m=f.cmd('startMeeting',{groupId:f.g2.groupId,topic:'valid',materials:[],maxOpinions:2}).result;for(const bot of f.bots.slice(0,2)){f.cmd('submitOpinion',{meetingId:m.meetingId,botId:bot.botId,content:bot.name==='B'?'REVOKED-SECRET':'valid'},m.revision);m=f.ledger.get('meeting',m.meetingId);}f.cmd('changeMembership',{groupId:f.g2.groupId,remove:[f.bots[1].botId],add:[]},f.g2.revision);const result=f.cmd('revealOpinions',{meetingId:m.meetingId},m.revision).result;assert.equal(result.opinions.length,1);assert.equal(result.missing[0].reason,'revoked');assert.ok(!JSON.stringify(result).includes('REVOKED-SECRET'));f.ledger.close();});
+test('archive restore cannot satisfy a meeting obligation from the old bot epoch',()=>{const f=fixture(),a=createBot(f,'A'),b=createBot(f,'B'),g=f.cmd('createGroup',{name:'G',namespace:'P',members:[a.botId,b.botId],coordinatorBotId:a.botId}).result,m=f.cmd('startMeeting',{groupId:g.groupId,topic:'epoch',materials:[],maxOpinions:2}).result,arch=f.cmd('archive',{kind:'bot',id:b.botId},b.revision).result;f.cmd('restore',{kind:'bot',id:b.botId},arch.revision);assert.throws(()=>f.cmd('submitOpinion',{meetingId:m.meetingId,botId:b.botId,content:'old obligation'},m.revision),{code:'membership_revoked'});const first=f.cmd('submitOpinion',{meetingId:m.meetingId,botId:a.botId,content:'valid'},m.revision).result;const latest=f.ledger.get('meeting',m.meetingId),revealed=f.cmd('revealOpinions',{meetingId:m.meetingId},latest.revision).result;assert.equal(revealed.opinions.length,1);assert.equal(revealed.opinions[0].opinionId,first.opinionId);assert.equal(revealed.missing[0].botId,b.botId);f.ledger.close();});
