{
  "name": "dsh-bot",
  "version": "1.0.0-alpha.1",
  "private": true,
  "type": "module",
  "main": "./src/native/plugin.mjs",
  "description": "官方 DSH 原生多 Bot、记忆、任务与群会议插件（开发中）",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "exports": {
    ".": "./src/native/plugin.mjs",
    "./client": "./src/client/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:native": "node --test test/native-plugin/*.native.test.mjs",
    "check": "node scripts/check.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage": "0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage": {
      "optional": true
    },
    "@deepseek-ai/dsh-atomic-write": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    }
  },
  "files": [
    "src/native",
    "src/client/client.js",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "docs/install.zh-CN.md",
    "docs/history/standalone-void.md"
  ],
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "playwright-core": "1.63.0"
  }
}
