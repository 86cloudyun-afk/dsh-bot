{
  "name": "dsh-bot",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "main": "./src/plugin.mjs",
  "description": "Capability-gated native DSH control layer candidate",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "exports": {
    ".": {
      "types": "./src/plugin.d.ts",
      "default": "./src/plugin.mjs"
    },
    "./host": {
      "types": "./src/host.d.ts",
      "default": "./src/host.mjs"
    },
    "./bot-read-source": {
      "types": "./src/bot-task-read-source.d.ts",
      "default": "./src/bot-task-read-source.mjs"
    },
    "./operator-read-binding": {
      "types": "./src/explicit-operator-read-binding.d.ts",
      "default": "./src/explicit-operator-read-binding.mjs"
    },
    "./plugin": {
      "types": "./src/plugin.d.ts",
      "default": "./src/plugin.mjs"
    },
    "./client": {
      "types": "./src/client/client.d.ts",
      "default": "./src/client/client.js"
    },
    "./package.json": "./package.json",
    "./owner-startup": {
      "types": "./src/owner-startup.d.ts",
      "default": "./src/owner-startup.mjs"
    },
    "./owner-app": {
      "types": "./src/owner-app.d.ts",
      "default": "./src/owner-app.mjs"
    },
    "./owner-protected-provider": {
      "types": "./src/owner-protected-provider.d.ts",
      "default": "./src/owner-protected-provider.mjs"
    },
    "./adapter": {
      "types": "./src/adapter.d.ts",
      "default": "./src/adapter.mjs"
    },
    "./native-controller": {
      "types": "./src/native-controller.d.ts",
      "default": "./src/native-controller.mjs"
    },
    "./session-creation": {
      "types": "./src/session-creation.d.ts",
      "default": "./src/session-creation.mjs"
    },
    "./bot-producer": {
      "types": "./src/bot-producer.d.ts",
      "default": "./src/bot-producer.mjs"
    },
    "./bot-chain-owner-app": {
      "types": "./src/bot-chain-owner-app.d.ts",
      "default": "./src/bot-chain-owner-app.mjs"
    },
    "./bot-chain-request-guard": {
      "types": "./src/bot-chain-request-guard.d.ts",
      "default": "./src/bot-chain-request-guard.mjs"
    },
    "./selected-bot-owner-policy": {
      "types": "./src/selected-bot-owner-policy.d.ts",
      "default": "./src/selected-bot-owner-policy.mjs"
    },
    "./bot-chain-intake": {
      "default": "./src/bot-chain-intake.mjs"
    },
    "./selected-bot-contact-owner": {
      "types": "./src/selected-bot-contact-owner.d.ts",
      "default": "./src/selected-bot-contact-owner.mjs"
    },
    "./bot-chain-native-owner-app": {
      "types": "./src/bot-chain-native-owner-app.d.ts",
      "default": "./src/bot-chain-native-owner-app.mjs"
    },
    "./bot-gui-owner-app": {
      "types": "./src/bot-gui-owner-app.d.ts",
      "default": "./src/bot-gui-owner-app.mjs"
    },
    "./bot-gui-startup": {
      "types": "./src/bot-gui-startup.d.ts",
      "default": "./src/bot-gui-startup.mjs"
    },
    "./bot-gui-session-controller": {
      "types": "./src/bot-gui-session-controller.d.ts",
      "default": "./src/bot-gui-session-controller.mjs"
    }
  },
  "types": "./src/plugin.d.ts",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:native": "node scripts/test-native.mjs",
    "start": "node src/server.mjs",
    "check": "node scripts/check.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-scope": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence-jsonl": {
      "optional": true
    }
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2"
  }
}
